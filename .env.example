# Base URL of the IRAS.API ASP.NET Core backend (no trailing slash)
VITE_API_BASE_URL=https://localhost:7031

# Google OAuth Web client ID (Google Cloud Console > APIs & Services > Credentials).
# Leave blank to keep Google sign-in disabled (the button falls back to a notice).
# Must match the backend's Authentication:Google:ClientId.
VITE_GOOGLE_CLIENT_ID=
